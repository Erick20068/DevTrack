<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ Asistente de voz"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🎙️ Toca el micrófono y habla"
            android:textColor="@color/textDim"
            android:textSize="14sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:fabSize="normal"
            android:backgroundTint="@color/primary"
            android:src="@drawable/ic_mic"
            app:tint="@color/bg"
            android:contentDescription="Micrófono" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="16dp">

            <TextView
                android:id="@+id/tvHeard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:padding="16dp"
                android:text="Aquí aparecerá lo que entienda…"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.3" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMotivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/bg"
            android:text="🔥 Motívame (te lo dice en voz alta)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpotify"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎵 Abrir Spotify — música para entrenar"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Comandos que entiendo:\n\n• \"Agregar tarea repasar Java\"\n• \"Postulé a Anyone AI\"\n• \"Estudié inglés 30 minutos\"\n• \"Estuve programando 2 horas\"\n• \"Entrené pierna hoy\"\n• \"Abre repaso / metas / entrena\"\n• \"Qué tengo hoy\"\n• \"Motívame\"\n• \"Pon música\""
            android:textColor="@color/textDim"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />
    </LinearLayout>
</ScrollView>
