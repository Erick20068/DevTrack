<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🃏 Aprender"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerDeck"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeCards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/bg"
            android:text="🃏 Flashcards" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeQuiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:backgroundTint="@color/secondary"
            android:textColor="@color/bg"
            android:text="✅ Quiz" />
    </LinearLayout>

    <!-- ══ MODO FLASHCARDS ══ -->
    <LinearLayout
        android:id="@+id/containerCards"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/textDim"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFlash"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.3"
                tools:text="¿Qué es la JVM?" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="◀"
                android:textColor="@color/text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/bg"
                android:text="Voltear 🔄" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="▶"
                android:textColor="@color/text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShuffle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔀"
                android:textColor="@color/text" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ MODO QUIZ ══ -->
    <LinearLayout
        android:id="@+id/containerQuiz"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/textDim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="¿Con qué método arranca un programa Java?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpt1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpt2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpt3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpt4"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextQ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/bg"
            android:visibility="gone"
            android:text="Siguiente ➜" />
    </LinearLayout>
</LinearLayout>
